#define ZMK_POINTING_DEFAULT_MOVE_VAL 1700 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30  // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>        // bluetooth
#include <dt-bindings/zmk/pointing.h>  // mouse

#define MAC 0  // mac os
#define WIN 1  // windows os
#define NUM 2  // number
#define SYS 3  // system such as media, bluetooth, bootloader, etc
#define PNT 4  // mouse

/ {
    combos {
        compatible = "zmk,combos";

        // One-handed SYS access. Combo-invoked behaviors always run on the
        // central half (combo.c hardcodes source = LOCAL), so reset/bootloader
        // must NOT be bound to combos directly. Instead the combo opens the
        // SYS layer (sticky, ~1s); the following real key press keeps its own
        // source, so &bootloader / &sys_reset run on the half it is pressed on:
        //   left : tap Q+C  then G = bootloader, B = sys_reset
        //   right: tap P+,  then H = bootloader, N = sys_reset
        // Right-half access still requires the halves to be paired; if pairing
        // is broken, use the physical RST button (double-tap) instead.

        combo_sys_left {  // Q + C
            timeout-ms = <50>;
            key-positions = <1 27>;
            bindings = <&sl SYS>;
            layers = <MAC WIN>;
            require-prior-idle-ms = <125>;
        };

        combo_sys_right {  // P + ,
            timeout-ms = <50>;
            key-positions = <10 32>;
            bindings = <&sl SYS>;
            layers = <MAC WIN>;
            require-prior-idle-ms = <125>;
        };
    };

    behaviors {
        ht_snip: hold_tap_snip {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {  // MAC 0
            bindings = <
&kp DEL        &mt EXCL Q  &mt AT W  &mt HASH E     &mt DLLR R    &mt PRCNT T        &mt MINUS Y    &mt AMPS U    &mt STAR I      &mt LPAR O    &mt RPAR P     &kp BSPC
&mt LCTRL ESC  &kp A  &ht_snip LG(LS(S)) S  &kp D     &kp F    &kp G        &kp H    &kp J    &kp K      &kp L    &kp SEMI  &mt RCTRL SQT
&mt LSHIFT CAPS      &mt LCTRL(Z) Z  &mt LCTRL(X) X  &mt LCTRL(C) C     &mt LCTRL(V) V    &kp B        &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT 
                             &kp LGUI  &kp RET  &to NUM    &mo NUM  &mo SPACE  &kp LALT
            >;
        };

         windows_layer {  // WIN 1
            bindings = <
&kp DEL        &mt EXCL Q  &mt AT W  &mt HASH E     &mt DLLR R    &mt PRCNT T        &mt MINUS Y    &mt AMPS U    &mt STAR I      &mt LPAR O    &mt RPAR P     &kp BSPC
&mt LCTRL ESC  &kp A  &ht_snip LG(LS(S)) S  &kp D     &kp F    &kp G        &kp H    &kp J    &kp K      &kp L    &kp SEMI  &mt RCTRL SQT
&mt LSHIFT CAPS      &mt LCTRL(Z) Z  &mt LCTRL(X) X  &mt LCTRL(C) C     &mt LCTRL(V) V    &kp B        &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT 
                             &kp LGUI  &kp RET  &to NUM    &mo NUM  &mo SPACE  &kp LALT
            >;
        };

        number_layer {  // NUM 2
            bindings = <
&trans  &kp CARET     &kp GRAVE    &kp LBKT         &kp RBKT      &kp BACKSLASH  &kp N7    &kp N8    &kp N9  &kp MINUS     &kp BSPC    &kp BACKSLASH
&trans     &none   &none  &none    &kp UP  &none   &kp N4  &kp N5  &kp N6  &kp PLUS  &kp UP  &kp STAR
&trans     &none  &none &kp LEFT  &kp DOWN   &kp RIGHT &KP N1     &kp N2     &kp N3  &kp LEFT    &kp DOWN  &kp RIGHT
                                &to SYS         &none     &to MAC  &kp EQUAL    &kp DOT    &KP N0
            >;
        };

        system_layer {  // SYS 3
            bindings = <
&none  &kp C_PP    &kp C_MUTE    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &none         &none        &to MAC       &to WIN       &none         &none         &bt BT_CLR
&none  &kp C_NEXT  &kp C_VOL_UP  &kp C_BRI_INC                      &kp GLOBE                               &bootloader   &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &kp C_PREV  &kp C_VOL_DN  &kp C_BRI_DEC                      &none                                   &sys_reset    &sys_reset   &none         &bt BT_PRV    &bt BT_NXT    &none         &none
                                 &none                              &trans                                  &none         &none        &trans        &none
            >;
        };

        mouse_layer {  // PNT 4
            bindings = <
&none      &none  &none  &none      &none  &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT    &none  &none
&none      &none  &none  &none      &none  &none    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT    &none  &none
&kp LSHFT  &none  &none  &none      &none  &none    &kp  C_AC_BACK  &none           &none         &kp  C_AC_FORWARD  &none  &none
                         &kp LCTRL  &none  &none    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };
    };
};
